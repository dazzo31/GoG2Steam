# Auto detect text files and perform LF normalization
* text=auto

# PowerShell scripts (Windows CRLF preferred for maximum ISE / Console compatibility)
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Documentation & Config
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
LICENSE text eol=lf
VERSION text eol=lf

# Binary files
*.vdf binary
*.zip binary
*.png binary
*.jpg binary
*.ico binary
